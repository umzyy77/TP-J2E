# ============================
# Application
# ============================
# Nom logique de l'application (affichage info/actuator)
APP_NAME=MasterAnnonce
# Port HTTP expose par le backend
APP_PORT=8080
# Chemin Swagger UI
SWAGGER_UI_PATH=/swagger-ui

# ============================
# Base de donnees PostgreSQL
# ============================
# Nom de la base
DB_NAME=MasterAnnonce
# Utilisateur PostgreSQL
DB_USER=postgres
# Mot de passe PostgreSQL
DB_PASSWORD=change_me
# Port PostgreSQL local/docker
DB_PORT=5432
# URL JDBC complete utilisee par Spring
DB_URL=jdbc:postgresql://localhost:5432/MasterAnnonce

# ============================
# JPA / Hibernate
# ============================
# update | validate | create | create-drop
JPA_DDL_AUTO=update
# true/false: affiche les requetes SQL
JPA_SHOW_SQL=true
# true/false: formate le SQL dans les logs
JPA_FORMAT_SQL=true
# true/false: garder la session ouverte pendant le rendu web
JPA_OPEN_IN_VIEW=false
# Cout BCrypt (rounds), borne back: 4..31
BCRYPT_ROUNDS=12

# ============================
# JWT
# ============================
# Secret du token d'acces (longueur elevee recommandee)
JWT_SECRET=MasterAnnonceSecretKeyForJWTSigningMustBeAtLeast256BitsLong!!
# Duree de vie access token en millisecondes (86400000 = 24h)
JWT_EXPIRATION=86400000
# Secret du refresh token
JWT_REFRESH_SECRET=MasterAnnonceRefreshSecretKeyForJWTSigningMustBeAtLeast256BitsLong!!
# Duree de vie refresh token en millisecondes (604800000 = 7 jours)
JWT_REFRESH_EXPIRATION=604800000

# ============================
# Rate limiting login
# ============================
# true/false: active le rate-limit sur login
RATE_LIMIT_LOGIN_ENABLED=true
# Endpoint protege par le rate-limit
RATE_LIMIT_LOGIN_PATH=/api/auth/login
# Nombre max de requetes autorisees dans la fenetre
RATE_LIMIT_LOGIN_MAX_REQUESTS=20
# Taille de la fenetre en secondes
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ============================
# Actuator
# ============================
# true/false: autorise les infos d'environnement dans /actuator/info
ACTUATOR_INFO_ENV_ENABLED=true
# Endpoints exposes publiquement
ACTUATOR_EXPOSED_ENDPOINTS=health,info
# never | when-authorized | always
ACTUATOR_HEALTH_SHOW_DETAILS=always
# never | when-authorized | always
ACTUATOR_HEALTH_SHOW_COMPONENTS=always
# true/false: inclure le check DB dans health
ACTUATOR_HEALTH_DB_ENABLED=true

# ============================
# Metadata /actuator/info
# ============================
INFO_APP_NAME=MasterAnnonce
INFO_APP_DESCRIPTION=API REST MasterAnnonce
INFO_APP_VERSION=1.0.0

# ============================
# Seed SQL (docker-entrypoint-initdb.d)
# ============================
# Mot de passe de seed (sera hashe en BCrypt)
SEED_DEFAULT_PASSWORD=password123
